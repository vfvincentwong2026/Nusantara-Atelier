{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2020"],
    "outDir": ".test-build",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "lib/estimate/**/*.ts",
    "lib/materials.ts",
    "lib/bom.ts",
    "lib/quote.ts",
    "lib/cases.ts",
    "lib/types.ts"
  ]
}
